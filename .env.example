# KinPress — copy to .env.local (local) or Vercel → Environment Variables
# Never commit .env.local. Never prefix secrets with NEXT_PUBLIC_.

# Required (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Optional
# NEXT_PUBLIC_ENABLE_SUPABASE_DEBUG=

# Not used by current app (server-only if added later)
# SUPABASE_SERVICE_ROLE_KEY=
