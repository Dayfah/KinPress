# =============================================================================
# KinPress — Vercel / local environment variables
# Copy to .env.local for development. Set the same keys in Vercel → Settings → Environment Variables.
# =============================================================================

# --- Required for auth, profiles, saved articles, admin (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional fallback (same role as anon key; use one or the other)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production site URL for auth email / OAuth redirects (e.g. https://kinpress.vercel.app)
# If unset, Vercel uses VERCEL_URL; local dev defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---

# GNews headlines for homepage wire + /api/news (optional — mock data used if missing)
GNEWS_API_KEY=

# Not used by this app today (reserved for future integrations):
# NEWS_API_KEY=
# GUARDIAN_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
