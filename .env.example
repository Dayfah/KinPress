# =============================================================================
# KinPress — copy to .env.local (local) or Vercel → Environment Variables
# Never commit .env.local. Never prefix secrets with NEXT_PUBLIC_.
# =============================================================================

# --- Required (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; or use legacy anon key (one required)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth email / redirect origin (recommended in production)
# Local: http://localhost:3000
# Production: https://kin-press.vercel.app
NEXT_PUBLIC_SITE_URL=

# Enable /debug/supabase on production (optional; dev enables automatically)
# NEXT_PUBLIC_ENABLE_SUPABASE_DEBUG=true

# --- Server-only (optional; not used by current app) ---
# SUPABASE_SERVICE_ROLE_KEY=
