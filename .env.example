# Supabase — required for signup/login (browser-safe publishable keys only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional fallback if ANON key is not set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production site URL for auth email links (e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Never add service role / secret keys with NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY must stay server-only and is not used by this app.

# Server-only — GNews headlines (never expose to the browser)
GNEWS_API_KEY=
