# =============================================================================
# KinPress — copy to .env.local (local) or Vercel → Project → Settings → Environment Variables
# Never commit .env.local. Never prefix secrets with NEXT_PUBLIC_.
# =============================================================================

# --- Required (browser-safe; bundled into client JS) ---

# Full Supabase project URL (https only in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Provide ONE public API key from Supabase → Project Settings → API:
#   - Publishable key (preferred), or
#   - Legacy anon JWT key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin for auth email links and OAuth redirects
# Local:  http://localhost:3000
# Vercel: https://kin-press.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Optional ---

# Expose /debug/supabase on production (dev enables automatically)
# NEXT_PUBLIC_ENABLE_SUPABASE_DEBUG=true

# Server-only key for protected ingestion jobs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Required to call /api/ingest/* routes from Vercel Cron or a trusted operator.
CRON_SECRET=

# Optional news ingestion sources. RSS entries can be URL or "Source Name|URL".
# Defaults are used when KINPRESS_NEWS_RSS_FEEDS is empty.
# KINPRESS_NEWS_RSS_FEEDS=https://capitalbnews.org/feed/,https://wordinblack.com/feed/

# Optional API/RSS keys and feeds for real content ingestion.
# GNEWS_API_KEY=
# KINPRESS_RESOURCE_FEED_URLS=https://example.org/verified-resources.json
# KINPRESS_OPPORTUNITY_FEED_URLS=https://example.org/opportunities.json
# KINPRESS_EVENT_FEED_URLS=https://example.org/events.json

# Emergency bypass for CI only — do not use on Vercel Production
# SKIP_ENV_VALIDATION=true

# --- NOT used by KinPress (do not add unless you add server code that needs them) ---
# ADMIN_EMAILS=                  # not referenced in src/
