# Internal npm registry configuration template
# Replace with your organization-approved registry URL.
registry=https://<YOUR_INTERNAL_NPM_REGISTRY>/

# If your internal registry proxies scoped packages, keep this.
@supabase:registry=https://<YOUR_INTERNAL_NPM_REGISTRY>/

# Auth token for private/internal registry (set in CI or shell; do not hardcode secrets).
//<YOUR_INTERNAL_NPM_REGISTRY_HOST>/:_authToken=${NPM_TOKEN}

strict-ssl=true
